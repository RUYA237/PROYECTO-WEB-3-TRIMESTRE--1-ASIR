# Configuración del Servidor
PORT=3000

# Configuración de Base de Datos
# IMPORTANTE: Cuando ejecutas con Docker Compose, DB_HOST debe ser "db" (nombre del servicio)
# Cuando ejecutas en local sin Docker, usa "127.0.0.1"
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=cambia_esta_clave
DB_NAME=empresa_core
